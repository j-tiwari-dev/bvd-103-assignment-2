{
  "name": "assignment-5",
  "version": "1.0.0",
  "description": "BVD 103 Assignment 5 backend API with OpenAPI documentation, generated TypeScript SDK, warehouse inventory, orders, and automated testing.",
  "main": "src/server.ts",
  "scripts": {
    "start-server": "tsx ./src/server.ts",
    "lint": "eslint",
    "lint:fix": "eslint . --ext .ts --fix",
    "check-types": "tsc --noEmit",
    "test": "vitest run src",
    "test:ci": "vitest run src",
    "test:api": "vitest run api-tests",
    "swagger": "tsoa spec",
    "routes": "tsoa routes",
    "generate-sdk": "openapi-generator-cli generate -i build/swagger.json -g typescript-fetch -o generated-client"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.2",
    "is-generator-function": "^1.1.0",
    "koa": "^2.16.4",
    "koa-bodyparser": "^4.4.1",
    "koa-qs": "^3.0.0",
    "koa2-swagger-ui": "^5.12.0",
    "mongodb": "^7.6.0",
    "tsoa": "^7.0.0-alpha.0",
    "tsx": "^4.21.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.42.1",
    "@playwright/test": "^1.57.0",
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^12.0.5",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-qs": "^2.0.4",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5"
  }
}